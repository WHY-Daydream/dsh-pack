{
  "name": "@why-daydream/dsh-pack",
  "version": "0.6.0",
  "description": "Portable, reproducible and verifiable runtime artifacts for DeepSeek Harness",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",

  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "type": "module",

  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],

  "publishConfig": {
    "access": "public"
  },

  "repository": {
    "type": "git",
    "url": "git+https://github.com/WHY-Daydream/dsh-pack.git"
  },
  "bugs": {
    "url": "https://github.com/WHY-Daydream/dsh-pack/issues"
  },
  "homepage": "https://github.com/WHY-Daydream/dsh-pack#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent",
    "agent-runtime",
    "oci",
    "supply-chain"
  ],

  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },

  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint ."
  },

  "dependencies": {
    "tar": "^7.4.3",
    "yaml": "^2.8.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-app-boot": ">=0.1.0-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../deepseek-harness/vendor/cordis",
    "@deepseek-ai/cordis-plugin-include": "link:../deepseek-harness/vendor/include",
    "@deepseek-ai/cordis-plugin-loader": "link:../deepseek-harness/vendor/loader",
    "@deepseek-ai/dsh-app-boot": "link:../deepseek-harness/packages/boot/app-boot",
    "@deepseek-ai/dsh-commands": "link:../deepseek-harness/packages/interaction/commands",
    "@deepseek-ai/dsh-home-paths": "link:../deepseek-harness/packages/util/home-paths",
    "@types/node": "^22.0.0",
    "oxlint": "^0.16.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
